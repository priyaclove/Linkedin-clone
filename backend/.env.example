# PostgreSQL connection string (from Render Postgres → "External Database URL")
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Cloudinary (from your Cloudinary dashboard → "API Environment variable")
# Leave unset for local dev to store uploads on disk instead.
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Your deployed frontend URL, for CORS (e.g. https://your-app.vercel.app)
FRONTEND_URL="http://localhost:3000"

# PORT is provided automatically by Render; only set locally if you want.
PORT=5002
